# Supabase project URL — Supabase dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — Project Settings → API → anon/public. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini API key — aistudio.google.com → Get API Key. Free tier (15 req/min, 1500 req/day).
GEMINI_API_KEY=

# Anthropic API key — console.anthropic.com → API Keys. Pay-as-you-go; used only on the high-stakes path.
ANTHROPIC_API_KEY=
